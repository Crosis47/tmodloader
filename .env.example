# Copy this file to .env next to docker-compose.yml.
# Recreate the container with docker compose up -d after changing .env.
# WebUI is enabled by default. Set TMOD_WEB_ENABLED=0 to run without it.

# ======================================================================
# 1. WEB UI - ENABLED BY DEFAULT
# ======================================================================
# Start with docker compose up -d, then read docker compose logs tmodloader.
# Open http://SERVER-IP:8080 and enter the one-time setup code from the logs.
# Choose your admin token; the game waits until first-run setup is complete.
# To skip the WebUI and setup entirely, set TMOD_WEB_ENABLED=0.
# Set TMOD_CONFIG_SOURCE=env to manage settings through Compose environment variables.
# web keeps settings UI-managed by default; env does not disable other admin actions.
# In web mode, saved WebUI values override matching environment values after
# first boot. Edit those values in the UI, then review/apply to restart the game.
# No secret mount is required for first-run setup.
# MAIN SWITCH: 0 disables the WebUI; 1 enables it.
TMOD_WEB_ENABLED=1
TMOD_CONFIG_SOURCE=web
# Dashboard port on the Docker host.
TMOD_WEB_HOST_PORT=8080
# Leave empty to use the server IP automatically, including custom ports.
# For a hostname/reverse proxy, set the exact browser URL (scheme and port).
# HTTP is allowed from RFC 1918 client IPs and loopback; other clients need HTTPS.
TMOD_WEB_ORIGIN=
# Optional single reverse proxy IP as seen by the container. Never use a wildcard.
# The proxy must overwrite X-Forwarded-For with one client IP and
# X-Forwarded-Proto with http or https, and preserve the browser Host header.
TMOD_WEB_TRUSTED_PROXY=
# Optional existing Argon2id hash file INSIDE the container (not plaintext).
# Leave empty for first-run setup; otherwise enable its matching Compose mount.
TMOD_WEB_TOKEN_FILE=
# Optional Steam API key file INSIDE the container; enable its matching mount.
# Needed only for Workshop search; URL/ID lookup and profiles need no key.
TMOD_WORKSHOP_KEY_FILE=

# ======================================================================
# 2. GAME NETWORK & ACCESS
# ======================================================================
# Docker maps HOST_PORT on your host to PORT inside this container.
# TMOD_HOST_PORT: the port players connect to on the Docker host.
# TMOD_PORT: the port tModLoader listens on inside the container.
# For one server, leave both at 7777. They do not have to match:
# a second server can use HOST_PORT=7778 and PORT=7777 (mapping 7778:7777).
# Players then connect to host port 7778; the game still listens on 7777 internally.
# Each server needs its own available host port; internal ports can be reused
# across separate containers. Forward the host port if configuring a router.
TMOD_HOST_PORT=7777
TMOD_PORT=7777
# USECONFIGFILE=Yes uses the customconfig.txt mount shown in Compose.
# Its listening port must match TMOD_PORT for the Docker mapping to work.
TMOD_USECONFIGFILE=No
TMOD_MOTD=A tModLoader server powered by Docker!
# Game password, not the WebUI admin token. Empty/N/A disables it.
TMOD_PASS=
# Optional game-password file INSIDE the container; enable its Compose mount.
TMOD_PASS_FILE=
TMOD_MAXPLAYERS=8
TMOD_LANGUAGE=en-US

# ======================================================================
# 3. WORLD SELECTION & GENERATION
# ======================================================================
# WORLDNAME selects a saved world or creates one if missing.
# Size: 1 small, 2 medium, 3 large. Difficulty: 0 Classic, 1 Expert, 2 Master, 3 Journey.
# Evil: random, corruption, crimson. Size/seed/evil/difficulty affect NEW worlds only.
# Choose an unused world name to generate a world with different options.
TMOD_WORLDNAME=Docker
TMOD_WORLDSIZE=3
TMOD_WORLDEVIL=random
TMOD_WORLDSEED=Docker
TMOD_DIFFICULTY=1

# ======================================================================
# 4. MODS & WORKSHOP
# ======================================================================
# MODS accepts comma-separated Workshop IDs and collection:ID entries.
# Offline policy: use-cache permits cached mods; strict requires successful updates.
# Download retry delay is in seconds; collection maximum limits expanded items.
TMOD_MODS=
TMOD_MOD_OFFLINE_POLICY=use-cache
TMOD_COLLECTION_MAX_ITEMS=1000
TMOD_DOWNLOAD_RETRIES=3
TMOD_DOWNLOAD_RETRY_DELAY=10

# ======================================================================
# 5. BACKUPS & AUTOSAVE
# ======================================================================
# Intervals are in minutes; 0 disables scheduling. 1440 = once every 24 hours.
# Backups save, stop and restart the game, disconnecting players.
# KEEP is the archive count; MIN_FREE_MB reserves disk space before backup.
# Autosave saves the live world; it does not create a backup archive.
TMOD_BACKUP_INTERVAL=0
TMOD_BACKUP_KEEP=7
TMOD_BACKUP_MIN_FREE_MB=1024
TMOD_AUTOSAVE_INTERVAL=10

# ======================================================================
# 6. RUNTIME & DIAGNOSTICS
# ======================================================================
# Shutdown timeout is in seconds; keep Compose stop_grace_period longer.
# Log level: quiet, normal, debug. CRASH_LOG_LINES controls failure diagnostics.
# SECURE is additional cheat checking (0/1); UPNP is automatic port mapping (0/1).
# NPCSTREAM and PRIORITY tune the native server; retain defaults unless needed.
TMOD_SHUTDOWN_MESSAGE=Server is shutting down NOW!
TMOD_SHUTDOWN_TIMEOUT=90
TMOD_LOG_LEVEL=normal
TMOD_CRASH_LOG_LINES=200
TMOD_SECURE=0
TMOD_NPCSTREAM=60
TMOD_UPNP=0
TMOD_PRIORITY=1

# ======================================================================
# 7. JOURNEY PERMISSIONS
# ======================================================================
# Journey worlds only. Each permission: 0 locked, 1 host only, 2 everyone.
# These control who may use each power; they do not convert a world to Journey.
TMOD_JOURNEY_SETFROZEN=0
TMOD_JOURNEY_SETDAWN=0
TMOD_JOURNEY_SETNOON=0
TMOD_JOURNEY_SETDUSK=0
TMOD_JOURNEY_SETMIDNIGHT=0
TMOD_JOURNEY_GODMODE=0
TMOD_JOURNEY_WIND_STRENGTH=0
TMOD_JOURNEY_RAIN_STRENGTH=0
TMOD_JOURNEY_TIME_SPEED=0
TMOD_JOURNEY_RAIN_FROZEN=0
TMOD_JOURNEY_WIND_FROZEN=0
TMOD_JOURNEY_PLACEMENT_RANGE=0
TMOD_JOURNEY_SET_DIFFICULTY=0
TMOD_JOURNEY_BIOME_SPREAD=0
TMOD_JOURNEY_SPAWN_RATE=0

# Operator commands (run on the Docker host):
#   docker compose logs --tail=100 --follow tmodloader
#   docker compose exec --user tml:tml -T tmodloader inject "save"
#   docker compose exec --user tml:tml -T tmodloader tmod-backup backup
# Startup repairs ./data and ./backups ownership, then runs as UID/GID 1000:1000.
