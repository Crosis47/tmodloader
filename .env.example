# Startup repairs ownership of ./data and ./backups for UID/GID 1000:1000, then
# runs the supervisor and game server as that low-privilege identity.
# Operator commands (comments only; run these on the Docker host):
#   docker compose logs --tail=100 --follow tmodloader
#   docker compose exec --user tml:tml -T tmodloader inject "save"
# Replace 100 at run time; the tail count is a Docker option, not an env value.
# Use inject for console commands instead of docker attach.
# Container-native backups use ./backups:/backups.
# Manual: docker compose exec --user tml:tml -T tmodloader tmod-backup backup
# Interval in minutes: 0 disables scheduling; 1440 backs up every 24 hours.
# Each backup briefly stops/restarts the game process and disconnects players.
TMOD_BACKUP_INTERVAL=0
TMOD_BACKUP_KEEP=7
TMOD_BACKUP_MIN_FREE_MB=1024

# Optional private admin interface. Uncomment its port and secret mounts in Compose.
# env = read-only settings; web = saved web settings override matching env values.
TMOD_WEB_ENABLED=0
TMOD_CONFIG_SOURCE=env
TMOD_WEB_HOST_PORT=8080
TMOD_WEB_ORIGIN=http://localhost:8080
TMOD_WEB_TOKEN_FILE=
# Optional Steam Web API key enables in-page search. URL/ID lookup needs no key.
TMOD_WORKSHOP_KEY_FILE=
# Docker networking. Publish TMOD_HOST_PORT on the host and keep TMOD_PORT in
# sync with the port on which tModLoader listens inside the container.
TMOD_HOST_PORT=7777
TMOD_PORT=7777

# Workshop IDs and collection:ID entries to keep current and enable.
TMOD_MODS=
TMOD_MOD_OFFLINE_POLICY=use-cache
TMOD_COLLECTION_MAX_ITEMS=1000
TMOD_DOWNLOAD_RETRIES=3
TMOD_DOWNLOAD_RETRY_DELAY=10

# Container behavior.
TMOD_AUTOSAVE_INTERVAL=10
TMOD_SHUTDOWN_MESSAGE=Server is shutting down NOW!
TMOD_SHUTDOWN_TIMEOUT=90
TMOD_LOG_LEVEL=normal
TMOD_CRASH_LOG_LINES=200

# Generated Terraria server configuration. An empty value or N/A disables the
# password; replace it before exposing the server to an untrusted network.
TMOD_USECONFIGFILE=No
TMOD_MOTD=A tModLoader server powered by Docker!
TMOD_PASS=
TMOD_PASS_FILE=
TMOD_MAXPLAYERS=8
TMOD_WORLDNAME=Docker
TMOD_WORLDSIZE=3
TMOD_WORLDSEED=Docker
TMOD_DIFFICULTY=1
TMOD_SECURE=0
TMOD_LANGUAGE=en-US
TMOD_NPCSTREAM=60
TMOD_UPNP=0
TMOD_PRIORITY=1

# Journey permission values: 0=locked, 1=host only, 2=everyone.
TMOD_JOURNEY_SETFROZEN=0
TMOD_JOURNEY_SETDAWN=0
TMOD_JOURNEY_SETNOON=0
TMOD_JOURNEY_SETDUSK=0
TMOD_JOURNEY_SETMIDNIGHT=0
TMOD_JOURNEY_GODMODE=0
TMOD_JOURNEY_WIND_STRENGTH=0
TMOD_JOURNEY_RAIN_STRENGTH=0
TMOD_JOURNEY_TIME_SPEED=0
TMOD_JOURNEY_RAIN_FROZEN=0
TMOD_JOURNEY_WIND_FROZEN=0
TMOD_JOURNEY_PLACEMENT_RANGE=0
TMOD_JOURNEY_SET_DIFFICULTY=0
TMOD_JOURNEY_BIOME_SPREAD=0
TMOD_JOURNEY_SPAWN_RATE=0
